events {
    # Maximum concurrent connections this Nginx worker can keep open.
    worker_connections 1024;
}

http {
    # Load standard MIME mappings so CSS, JS, images, and fonts get correct Content-Type values.
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Structured edge diagnostics omit paths, IP addresses, query strings, referrers, and user agents.
    log_format main escape=json '{"timestamp":"$time_iso8601",'
                                '"event.name":"Nginx.RequestCompleted",'
                                '"http.request.method":"$request_method",'
                                '"http.response.status_code":$status,'
                                '"http.response.body.size":$body_bytes_sent,'
                                '"server.duration":$request_time}';

    access_log  /var/log/nginx/access.log  main;
    error_log   /var/log/nginx/error.log   warn;

    sendfile        on;
    keepalive_timeout  65;

    server {
        # Azure Container Apps sends traffic to the container on port 80.
        listen       80;
        server_name  localhost;

        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://*.in.applicationinsights.azure.com https://dc.services.visualstudio.com; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'; upgrade-insecure-requests" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;

        # Serve the built Vite/React app from the Nginx image filesystem.
        location / {
            root   /usr/share/nginx/html;
            # A real directory without its own index falls back to the SPA root instead of returning 403.
            index  index.html /index.html;
            # Serve real static files; all other paths are handled by the client-side router.
            try_files $uri /index.html;
        }

        # Reverse proxy /api/* to the internal API container app from API_UPSTREAM.
        location /api/ {
            proxy_pass ${API_UPSTREAM}/api/;
            proxy_http_version 1.1;
            # Preserve upgrade semantics for protocols that need an HTTP/1.1 connection upgrade.
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            # Keep upstream routing intact while forwarding the browser-facing origin to ASP.NET.
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            # Preserve only W3C trace context across the proxy trust boundary.
            proxy_set_header traceparent $http_traceparent;
            proxy_set_header tracestate $http_tracestate;
            proxy_set_header baggage "";
            proxy_set_header Request-Id "";
            proxy_set_header Request-Context "";
            proxy_cache_bypass $http_upgrade;
            # Enable TLS SNI when API_UPSTREAM is an HTTPS endpoint.
            proxy_ssl_server_name on;
            proxy_ssl_name $proxy_host;
        }

        error_page   500 502 503 504  /50x.html;
        location = /50x.html {
            root   /usr/share/nginx/html;
        }
    }
}
